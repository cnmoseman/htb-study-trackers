<node name="Target 1" unique_id="550" master_id="0" prog_lang="custom-colors" tags="cpts target" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#af65f4">At a glance
</rich_text>
<rich_text>Status: todo, enumerating, foothold, root or done. Access: none, user or admin.</rich_text>
<rich_text>
</rich_text>
<rich_text>Creds go in </rich_text>
<rich_text link="node 544" foreground="#af65f4">Credentials</rich_text>
<rich_text>, flags in </rich_text>
<rich_text link="node 547" foreground="#af65f4">Flags</rich_text>
<rich_text>, changes in </rich_text>
<rich_text link="node 548" foreground="#af65f4">Cleanup</rich_text>
<rich_text>.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Access So Far</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">every account you've had here, newest at the bottom</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Ports &amp; Services</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Next Up</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">what to try next; tick it off or move it to Dead Ends</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text style="italic">e.g. Check what file types the upload form accepts</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Enumeration</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Notes</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Web app on port 80 has an upload form</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Commands</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Foothold</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Notes</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Got a shell as the web server user</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Commands</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Privilege Escalation</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Notes</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. A scheduled task runs a writable script as root</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Commands</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Loot</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">files, keys, hashes; credentials go in the Credentials note</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. A backup file with database settings</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Pivots</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">what this host can reach</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. A second network card on an internal subnet</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Report Evidence</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text style="italic">e.g. Screenshot that shows this step worked</rich_text>
<rich_text> </rich_text>
<rich_text style="italic" foreground="#8a8d96">paste it right here with Ctrl+V</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Dead Ends</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">what you tried that didn't work, so you don't try it again</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. An approach you tried for an hour with no result</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Related Modules</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. </rich_text>
<rich_text style="italic" link="node 14" foreground="#af65f4">M01 - Penetration Testing Process</rich_text>
<rich_text>
