</node>
<node name="04 - Credentials" unique_id="544" master_id="0" prog_lang="custom-colors" tags="cpts exam" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#af65f4">In the report
</rich_text>
<rich_text>The Username, Type, Method and Notes columns become the </rich_text>
