<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">one heading per job you use it for</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h3" weight="heavy" style="italic">e.g. Fast first sweep of a subnet</rich_text>
