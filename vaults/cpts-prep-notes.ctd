<node name="03 - Network Map" unique_id="543" master_id="0" prog_lang="custom-colors" tags="cpts exam" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Map</rich_text>
