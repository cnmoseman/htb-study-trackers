<node name="Tools &amp; Services" unique_id="537" master_id="0" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="1" foreground="#af65f4" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text>One node per tool and one per service. </rich_text>
<rich_text link="node 538" foreground="#af65f4">Nmap</rich_text>
<rich_text> and </rich_text>
<rich_text link="node 539" foreground="#af65f4">SMB</rich_text>
<rich_text> are there to start you off.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>For a new one, duplicate </rich_text>
<rich_text weight="heavy">Templates › Tool</rich_text>
<rich_text> or </rich_text>
<rich_text weight="heavy">Templates › Service</rich_text>
<rich_text> (</rich_text>
<rich_text weight="heavy">Tree › Duplicate Node</rich_text>
<rich_text>) and drag the copy here.</rich_text>
<rich_text>
</rich_text>
<node name="Nmap" unique_id="538" master_id="0" prog_lang="custom-colors" tags="cpts tool" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#af65f4">At a glance
</rich_text>
<rich_text>Job: </rich_text>
<rich_text style="italic">e.g. Finds open ports and the services behind them</rich_text>
<rich_text>
</rich_text>
<rich_text>Learned in: </rich_text>
<rich_text link="node 54" foreground="#af65f4">M03 - Network Enumeration with Nmap</rich_text>
<rich_text>
</rich_text>
<rich_text>Install: </rich_text>
<rich_text style="italic">e.g. Already on Kali and Pwnbox</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#af65f4">Go-To Commands</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">the ones you reach for first, best one on top</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
