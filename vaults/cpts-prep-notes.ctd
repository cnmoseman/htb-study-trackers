<rich_text>
</rich_text>
<table char_offset="88" justification="left" col_min="60" col_max="240" is_light="0" col_widths="191,236"><row><cell>e.g. 10.129.x.x</cell><cell>e.g. External web server</cell></row><row><cell>Host/URL/IP Address</cell><cell>Description</cell></row></table>
<table char_offset="206" justification="left" col_min="60" col_max="240" is_light="0" col_widths="110,240"><row><cell>Exam start</cell><cell>e.g. 2026-11-01 09:00 UTC</cell></row><row><cell>Exam end</cell><cell></cell></row><row><cell>Report due</cell><cell></cell></row><row><cell>Item</cell><cell>Date and time</cell></row></table>
