<table char_offset="282" justification="left" col_min="60" col_max="240" is_light="0" col_widths="92,164"><row><cell>Critical</cell><cell>9.0 to 10.0</cell></row><row><cell>High</cell><cell>7.0 to 8.9</cell></row><row><cell>Medium</cell><cell>4.0 to 6.9</cell></row><row><cell>Low</cell><cell>0.1 to 3.9</cell></row><row><cell>Info</cell><cell>0.0</cell></row><row><cell>Rating</cell><cell>CVSS score range</cell></row></table>
