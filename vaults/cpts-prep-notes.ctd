<node name="05 - Findings" unique_id="545" master_id="0" prog_lang="custom-colors" tags="cpts exam" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text>Write every finding here as you go, then write each one up properly in the report. A finding can be on the attack path or standalone.</rich_text>
