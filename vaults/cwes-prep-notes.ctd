<rich_text> and </rich_text>
<rich_text link="node 315" foreground="#ec5651">GraphQL</rich_text>
<rich_text> are there to start you off.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>For a new one, duplicate </rich_text>
<rich_text weight="heavy">Templates › Tool</rich_text>
<rich_text> or </rich_text>
<rich_text weight="heavy">Templates › Notes/Technologies</rich_text>
<rich_text> (</rich_text>
<rich_text weight="heavy">Tree › Duplicate Node</rich_text>
<rich_text>) and drag the copy here.</rich_text>
<rich_text>
</rich_text>
<node name="ffuf" unique_id="314" master_id="0" prog_lang="custom-colors" tags="cwes tool" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
