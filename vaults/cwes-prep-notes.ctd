</rich_text>
<node name="App 1" unique_id="322" master_id="0" prog_lang="custom-colors" tags="cwes app" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#ec5651">At a glance
</rich_text>
<rich_text>Status: todo, mapping, testing, exploited or done.</rich_text>
<rich_text>
</rich_text>
<rich_text>Findings go in </rich_text>
<rich_text link="node 319" foreground="#ec5651">Findings</rich_text>
