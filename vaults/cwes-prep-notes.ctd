<rich_text>
</rich_text>
<table char_offset="97" justification="left" col_min="60" col_max="240" is_light="0" col_widths="70,119,110,119"><row><cell>1</cell><cell></cell><cell></cell><cell></cell></row><row><cell>2</cell><cell></cell><cell></cell><cell></cell></row><row><cell>3</cell><cell></cell><cell></cell><cell></cell></row><row><cell>4</cell><cell></cell><cell></cell><cell></cell></row><row><cell>5</cell><cell></cell><cell></cell><cell></cell></row><row><cell>6</cell><cell></cell><cell></cell><cell></cell></row><row><cell>7</cell><cell></cell><cell></cell><cell></cell></row><row><cell>8</cell><cell></cell><cell></cell><cell></cell></row><row><cell>9</cell><cell></cell><cell></cell><cell></cell></row><row><cell>10</cell><cell></cell><cell></cell><cell></cell></row><row><cell>#</cell><cell>Application</cell><cell>Flag Value</cell><cell>Method Used</cell></row></table>
</node>
<node name="Apps" unique_id="321" master_id="0" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="1" foreground="#ec5651" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text>One node per item. Start with </rich_text>
<rich_text link="node 322" foreground="#ec5651">App 1</rich_text>
<rich_text> and rename it. For each new one, duplicate </rich_text>
<rich_text weight="heavy">Templates › App</rich_text>
<rich_text> (</rich_text>
<rich_text weight="heavy">Tree › Duplicate Node</rich_text>
<rich_text>) and drag the copy under </rich_text>
<rich_text weight="heavy">Apps</rich_text>
<rich_text>.</rich_text>
