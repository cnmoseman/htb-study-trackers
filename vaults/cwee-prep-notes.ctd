<rich_text link="node 280" foreground="#ac8300">Findings</rich_text>
<rich_text>, flags in </rich_text>
<rich_text link="node 281" foreground="#ac8300">Flags</rich_text>
<rich_text>.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
