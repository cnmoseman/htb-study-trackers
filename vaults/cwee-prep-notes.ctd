</node>
<node name="02 - Scope &amp; Rules" unique_id="279" master_id="0" prog_lang="custom-colors" tags="cwee exam" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text scale="h2" weight="heavy" foreground="#ac8300">In Scope Assets</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">copy these from the letter of engagement; the report has the same table</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
