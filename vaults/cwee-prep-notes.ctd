<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">End of Day</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Flags so far: </rich_text>
