<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. A host the letter says not to touch</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Rules of Engagement</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. No denial of service</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
