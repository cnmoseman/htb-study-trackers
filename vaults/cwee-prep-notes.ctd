<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Accounts</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Next Up</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">what to try next; tick it off or move it to Dead Ends</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text style="italic">e.g. Check how the search box handles special characters</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Tests</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Notes</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Search box reflects input back into the page</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Commands</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Source Code Review</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Exploit</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Notes</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Script that chains the two bugs into one flag</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Commands</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Patch</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Use a strict comparison and add a test for it</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Exploitation</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Notes</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Chained two bugs to reach the admin panel</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Commands</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Report Evidence</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text style="italic">e.g. Screenshot that shows this step worked</rich_text>
<rich_text> </rich_text>
<rich_text style="italic" foreground="#8a8d96">paste it right here with Ctrl+V</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#ac8300">Dead Ends</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">what you tried that didn't work, so you don't try it again</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
