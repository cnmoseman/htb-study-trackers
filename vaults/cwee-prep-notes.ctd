<table char_offset="344" justification="left" col_min="60" col_max="240" is_light="0" col_widths="92,164"><row><cell>Critical</cell><cell>9.0 to 10.0</cell></row><row><cell>High</cell><cell>7.0 to 8.9</cell></row><row><cell>Medium</cell><cell>4.0 to 6.9</cell></row><row><cell>Low</cell><cell>0.1 to 3.9</cell></row><row><cell>Info</cell><cell>0.0</cell></row><row><cell>Rating</cell><cell>CVSS score range</cell></row></table>
</node>
<node name="04 - Flags" unique_id="281" master_id="0" prog_lang="custom-colors" tags="cwee exam" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#ac8300">6 flags, 5 to pass
</rich_text>
<rich_text>Reviewers report 6 flags across 3 apps, with 5 needed to pass, </rich_text>
<rich_text weight="heavy">and</rich_text>
<rich_text> a report that passes.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">add rows as you find more</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text foreground="#8a8d96">────────────────────────────────────────
</rich_text>
<rich_text link="node 277" foreground="#ac8300">Exam</rich_text>
<rich_text> · </rich_text>
