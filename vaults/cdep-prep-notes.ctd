<node name="Methodology Phase" unique_id="305" master_id="0" prog_lang="custom-colors" tags="cdep methodology" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#2f9e44">Goal
</rich_text>
<rich_text style="italic" foreground="#8a8d96">what this phase is for in your workflow, and when you move on</rich_text>
<rich_text>
</rich_text>
<rich_text>
