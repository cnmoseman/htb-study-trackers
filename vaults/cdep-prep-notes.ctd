<table char_offset="1290" justification="left" col_min="60" col_max="240" is_light="0" col_widths="240,240,137,155"><row><cell>5 Core to (Sub-) Technique</cell><cell>e.g. Bits-Client/Operational, event ID 3 "BITS job created"</cell><cell></cell><cell></cell></row><row><cell>4 Core to Some Implementation of (Sub-) Technique</cell><cell></cell><cell></cell><cell></cell></row><row><cell>3 Core to Pre-Existing Tool or Inside Boundary</cell><cell>e.g. PowerShell 4104 with Start-BitsTransfer</cell><cell></cell><cell></cell></row><row><cell>2 Core to Adversary-Brought Tool or Outside Boundary</cell><cell></cell><cell></cell><cell></cell></row><row><cell>1 Ephemeral</cell><cell>e.g. the BITS job's DisplayName</cell><cell></cell><cell></cell></row><row><cell>Level</cell><cell>Application (A)</cell><cell>User-Mode (U)</cell><cell>Kernel-Mode (K)</cell></row></table>
<table char_offset="1352" justification="left" col_min="60" col_max="240" is_light="0" col_widths="240,200,191"><row><cell>5 Core to (Sub-) Technique</cell><cell></cell><cell></cell></row><row><cell>4 Core to Some Implementation of (Sub-) Technique</cell><cell></cell><cell></cell></row><row><cell>3 Core to Pre-Existing Tool or Inside Boundary</cell><cell></cell><cell></cell></row><row><cell>2 Core to Adversary-Brought Tool or Outside Boundary</cell><cell></cell><cell></cell></row><row><cell>1 Ephemeral</cell><cell></cell><cell></cell></row><row><cell>Level</cell><cell>Protocol Payload (P)</cell><cell>Protocol Header (H)</cell></row></table>
