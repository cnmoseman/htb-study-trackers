<rich_text weight="heavy" foreground="#0098a3">20 flags, 17 to pass
</rich_text>
<rich_text>Incident 1 has 20 flags. You need 17 (85 points) </rich_text>
<rich_text weight="heavy">and</rich_text>
<rich_text> a report that covers both incidents.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">add rows as you find more</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text foreground="#8a8d96">────────────────────────────────────────
</rich_text>
<rich_text link="node 199" foreground="#0098a3">Exam</rich_text>
<rich_text> · </rich_text>
<rich_text link="node 1" foreground="#0098a3">Home</rich_text>
<rich_text>
</rich_text>
