<node name="Incident" unique_id="216" master_id="0" prog_lang="custom-colors" tags="cdsa incident" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#0098a3">At a glance
</rich_text>
<rich_text>Platform: the SIEM you investigate this in. Status: open, investigating or closed.</rich_text>
<rich_text>
</rich_text>
<rich_text>IOCs go in </rich_text>
<rich_text link="node 202" foreground="#0098a3">IOCs</rich_text>
<rich_text>, flags in </rich_text>
<rich_text link="node 203" foreground="#0098a3">Flags</rich_text>
<rich_text>.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Overview</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Phishing email led to malware on one workstation</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Key Findings</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. The attacker moved from the workstation to a file server</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Immediate Actions</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Isolate the two affected hosts</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Stakeholder Impact</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. File server data may have been copied out</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Affected Systems &amp; Data</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. WS01, FS01 and the shared finance folder</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Next Up</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">what to check next; tick it off as you go</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text style="italic">e.g. Check whether FS01 talked to any outside address</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Evidence Sources &amp; Analysis</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">each detection step by step: data source, query, what it showed</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Notes</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Process creation logs show an Office app starting a script host</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Queries</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Kill Chain</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">the report has to cover every stage</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Root Cause Analysis</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. A user opened a macro document from an external sender</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Technical Timeline</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
