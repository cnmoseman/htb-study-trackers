<codebox char_offset="19" justification="left" frame_width="100" frame_height="74" width_in_pixels="0" syntax_highlighting="sh" highlight_brackets="1" show_line_numbers="0"># command            # what it does</codebox>
</node>
</node>
</node>
<node name="Tools &amp; Log Sources" unique_id="196" master_id="0" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="1" foreground="#0098a3" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text>One node per tool and one per log source. </rich_text>
<rich_text link="node 197" foreground="#0098a3">Splunk</rich_text>
<rich_text> and </rich_text>
<rich_text link="node 198" foreground="#0098a3">Sysmon</rich_text>
<rich_text> are there to start you off.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>For a new one, duplicate </rich_text>
<rich_text weight="heavy">Templates › Tool</rich_text>
<rich_text> or </rich_text>
<rich_text weight="heavy">Templates › Log Source</rich_text>
<rich_text> (</rich_text>
<rich_text weight="heavy">Tree › Duplicate Node</rich_text>
<rich_text>) and drag the copy here.</rich_text>
<rich_text>
</rich_text>
<node name="Splunk" unique_id="197" master_id="0" prog_lang="custom-colors" tags="cdsa tool" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#0098a3">At a glance
</rich_text>
<rich_text>Job: </rich_text>
<rich_text style="italic">e.g. Searches and charts logs from every host in one place</rich_text>
<rich_text>
</rich_text>
<rich_text>Learned in: </rich_text>
<rich_text link="node 52" foreground="#0098a3">M05 - Understanding Log Sources &amp; Investigating with Splunk</rich_text>
<rich_text>
</rich_text>
<rich_text>Install: </rich_text>
<rich_text style="italic">e.g. Web UI in the lab; nothing to install</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Go-To Commands</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">the ones you reach for first, best one on top</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Options Worth Knowing</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Use Cases</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">one heading per job you use it for</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h3" weight="heavy" style="italic">e.g. Find every process a user started</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Notes</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Commands</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Reading the Output</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">what a good result looks like, and what you do next</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. Use stats count by field to spot the rare value that stands out</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">When It Fails</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Gotchas / Lessons Learned</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Links</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Used in: </rich_text>
<rich_text style="italic" foreground="#8a8d96">link the methodology phase(s)</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Log Sources: </rich_text>
<rich_text style="italic">e.g. </rich_text>
<rich_text style="italic" link="node 198" foreground="#0098a3">Sysmon</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Index: </rich_text>
<rich_text link="node 13" foreground="#0098a3">Modules</rich_text>
<rich_text>
</rich_text>
<codebox char_offset="262" justification="left" frame_width="100" frame_height="74" width_in_pixels="0" syntax_highlighting="text" highlight_brackets="1" show_line_numbers="0"># query              # what it shows</codebox>
<table char_offset="287" justification="left" col_min="60" col_max="240" is_light="0" col_widths="146,240,240"><row><cell>e.g. earliest=</cell><cell>e.g. Sets the start of the time range</cell><cell>e.g. Every search, to keep it fast</cell></row><row><cell>Option</cell><cell>What it does</cell><cell>When I use it</cell></row></table>
<codebox char_offset="394" justification="left" frame_width="100" frame_height="74" width_in_pixels="0" syntax_highlighting="text" highlight_brackets="1" show_line_numbers="0"># query              # what it shows</codebox>
<table char_offset="554" justification="left" col_min="60" col_max="240" is_light="0" col_widths="240,240,240"><row><cell>e.g. Search returns nothing</cell><cell>e.g. Wrong index or time range</cell><cell>e.g. Search index= over All time once to find it</cell></row><row><cell>Symptom</cell><cell>Likely cause</cell><cell>Fix or backup tool</cell></row></table>
</node>
<node name="Sysmon" unique_id="198" master_id="0" prog_lang="custom-colors" tags="cdsa log-source" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#0098a3">At a glance
</rich_text>
<rich_text>What it is: </rich_text>
<rich_text style="italic">e.g. Detailed Windows process, network and file events</rich_text>
<rich_text>
</rich_text>
<rich_text>Searched in: </rich_text>
<rich_text style="italic">e.g. Splunk or Elastic</rich_text>
<rich_text>
</rich_text>
<rich_text>Learned in: </rich_text>
<rich_text link="node 38" foreground="#0098a3">M03 - Windows Event Logs &amp; Finding Evil</rich_text>
<rich_text>
</rich_text>
<rich_text>Usual tools: </rich_text>
<rich_text style="italic">e.g. </rich_text>
<rich_text style="italic" link="node 197" foreground="#0098a3">Splunk</rich_text>
<rich_text style="italic">, Event Viewer</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">First Look</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">the first queries you run against it</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Checklist</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Which hosts send it, and to which index</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Time range it covers</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Key event IDs or fields noted</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Gaps and noise noted</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Useful queries saved to </rich_text>
<rich_text link="node 202" foreground="#0098a3">IOCs</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Red Flags</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">things that usually mean a way forward</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Queries by Goal</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">one heading per thing you want from it</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h3" weight="heavy" style="italic">e.g. Trace a process tree</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Notes</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Queries</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Gotchas / Lessons Learned</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Links</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Used in: </rich_text>
<rich_text style="italic" foreground="#8a8d96">link the methodology phase(s)</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Tools: </rich_text>
<rich_text style="italic">e.g. </rich_text>
<rich_text style="italic" link="node 197" foreground="#0098a3">Splunk</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Index: </rich_text>
<rich_text link="node 13" foreground="#0098a3">Modules</rich_text>
<rich_text>
</rich_text>
<codebox char_offset="255" justification="left" frame_width="100" frame_height="74" width_in_pixels="0" syntax_highlighting="text" highlight_brackets="1" show_line_numbers="0"># query              # what it shows</codebox>
<table char_offset="469" justification="left" col_min="60" col_max="240" is_light="0" col_widths="240,240,240"><row><cell>e.g. An Office app starting a script host</cell><cell>e.g. Classic sign of a malicious document</cell><cell>e.g. Pull the full process tree for that host</cell></row><row><cell>What you see</cell><cell>Why it matters</cell><cell>Next step</cell></row></table>
<codebox char_offset="572" justification="left" frame_width="100" frame_height="74" width_in_pixels="0" syntax_highlighting="text" highlight_brackets="1" show_line_numbers="0"># query              # what it shows</codebox>
</node>
</node>
<node name="Exam" unique_id="199" master_id="0" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="1" foreground="#0098a3" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h1" weight="heavy" foreground="#0098a3">Exam</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>Your workspace for exam days: incidents, IOCs, flags and a log for each day. Every table here matches a part of the </rich_text>
<rich_text link="webs https://docs.sysreptor.com/assets/reports/HTB-CDSA-Report.pdf" foreground="#0098a3">official CDSA report template</rich_text>
<rich_text>, so by the end most of the report is already written down.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy" foreground="#e03131">Keep this file private
</rich_text>
<rich_text>Once you start the exam, this file holds exam content. Don't push it to a public GitHub repo or share it, during or after the exam. HTB's terms don't allow it. To lock it with a password, use </rich_text>
<rich_text weight="heavy">File › Save As</rich_text>
<rich_text> and pick a </rich_text>
<rich_text weight="heavy">Password Protected</rich_text>
<rich_text> storage type (</rich_text>
<rich_text family="monospace" foreground="#0098a3">.ctx</rich_text>
<rich_text> or </rich_text>
<rich_text family="monospace" foreground="#0098a3">.ctz</rich_text>
<rich_text>).</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Start here</rich_text>
<rich_text>
</rich_text>
<rich_text>1. </rich_text>
<rich_text link="node 200" foreground="#0098a3">01 - Before You Start</rich_text>
<rich_text>: go through the checklist before you start.</rich_text>
<rich_text>
</rich_text>
<rich_text>2. </rich_text>
<rich_text link="node 201" foreground="#0098a3">02 - Scope &amp; Rules</rich_text>
<rich_text>: copy the scope from the letter of engagement.</rich_text>
<rich_text>
</rich_text>
<rich_text>3. Keep a log as you work: </rich_text>
<rich_text weight="heavy">Log</rich_text>
<rich_text> has one node per exam day, from </rich_text>
<rich_text link="node 207" foreground="#0098a3">Day 01</rich_text>
<rich_text> to </rich_text>
<rich_text link="node 213" foreground="#0098a3">Day 07</rich_text>
<rich_text>.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Incidents</rich_text>
<rich_text>
</rich_text>
<rich_text>One node per item under </rich_text>
<rich_text weight="heavy">Incidents</rich_text>
<rich_text>. Start with </rich_text>
<rich_text link="node 205" foreground="#0098a3">Incident 1</rich_text>
<rich_text> and rename it. For each new one, duplicate </rich_text>
<rich_text weight="heavy">Templates › Incident</rich_text>
<rich_text> (</rich_text>
<rich_text weight="heavy">Tree › Duplicate Node</rich_text>
<rich_text>) and drag the copy under </rich_text>
<rich_text weight="heavy">Incidents</rich_text>
<rich_text>.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Tracking</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text link="node 202" foreground="#0098a3">03 - IOCs</rich_text>
<rich_text>: every indicator you find, and where you saw it.</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text link="node 203" foreground="#0098a3">04 - Flags</rich_text>
<rich_text>: every flag and where it came from. Report: </rich_text>
<rich_text style="italic">Flags Discovered</rich_text>
<rich_text>.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text foreground="#8a8d96">────────────────────────────────────────
</rich_text>
<rich_text link="node 1" foreground="#0098a3">Home</rich_text>
<rich_text>
</rich_text>
<encoded_png char_offset="0" justification="left" link=""></encoded_png>
<node name="01 - Before You Start" unique_id="200" master_id="0" prog_lang="custom-colors" tags="cdsa exam" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Setup</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>VPN connects and you can open the SIEM</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Screenshot tool ready (Flameshot or similar). Paste each screenshot straight into the host's node with </rich_text>
<rich_text family="monospace" foreground="#0098a3">Ctrl+V</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Screenshot names picked, like </rich_text>
<rich_text family="monospace" foreground="#0098a3">inc1-04-script-host.png</rich_text>
<rich_text> (item, step, what it shows), so you can find each one when you write the report</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Somewhere to save every query and its results</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Report started from the HTB CDSA template in SysReptor</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Autosave and backups on: </rich_text>
<rich_text weight="heavy">File › Preferences › Miscellaneous</rich_text>
<rich_text>, tick </rich_text>
<rich_text weight="heavy">Autosave Every x Minutes</rich_text>
<rich_text> and </rich_text>
<rich_text weight="heavy">Create a Backup Copy Before Saving</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>A copy of this file kept somewhere private. Only open it in one CherryTree window at a time, or you can lose changes</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Read</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Letter of engagement read twice, scope copied into </rich_text>
<rich_text link="node 201" foreground="#0098a3">02 - Scope &amp; Rules</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Exam start time, end time and report deadline written down</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>What counts as a flag and how to submit it</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Plan</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Rough plan for each day, with real breaks</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Sleep plan. Long exams are lost to fatigue more often than to missing skills.</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text style="italic">e.g. Wordlists and tools ready on your attack box</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text foreground="#8a8d96">────────────────────────────────────────
</rich_text>
<rich_text link="node 199" foreground="#0098a3">Exam</rich_text>
<rich_text> · </rich_text>
<rich_text link="node 1" foreground="#0098a3">Home</rich_text>
<rich_text>
</rich_text>
</node>
<node name="02 - Scope &amp; Rules" unique_id="201" master_id="0" prog_lang="custom-colors" tags="cdsa exam" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text scale="h2" weight="heavy" foreground="#0098a3">In Scope Assets</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">copy these from the letter of engagement; the report has the same table</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Out of Scope</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. A host the letter says not to touch</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Rules of Engagement</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. No denial of service</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#0098a3">Timeline</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text foreground="#8a8d96">────────────────────────────────────────
</rich_text>
<rich_text link="node 199" foreground="#0098a3">Exam</rich_text>
<rich_text> · </rich_text>
<rich_text link="node 1" foreground="#0098a3">Home</rich_text>
<rich_text>
</rich_text>
<table char_offset="88" justification="left" col_min="60" col_max="240" is_light="0" col_widths="191,240"><row><cell>e.g. SIEM</cell><cell>e.g. Logs for both incidents</cell></row><row><cell>Host/URL/IP Address</cell><cell>Description</cell></row></table>
<table char_offset="206" justification="left" col_min="60" col_max="240" is_light="0" col_widths="110,240"><row><cell>Exam start</cell><cell>e.g. 2026-11-01 09:00 UTC</cell></row><row><cell>Exam end</cell><cell></cell></row><row><cell>Report due</cell><cell></cell></row><row><cell>Item</cell><cell>Date and time</cell></row></table>
</node>
<node name="03 - IOCs" unique_id="202" master_id="0" prog_lang="custom-colors" tags="cdsa exam" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text foreground="#8a8d96">────────────────────────────────────────
</rich_text>
<rich_text link="node 199" foreground="#0098a3">Exam</rich_text>
<rich_text> · </rich_text>
<rich_text link="node 1" foreground="#0098a3">Home</rich_text>
<rich_text>
</rich_text>
