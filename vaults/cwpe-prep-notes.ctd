<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Connected clients listed</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Known weaknesses for this setup checked</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Handshake or other material captured</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Captured material cracked or queued</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
