<node name="Tools &amp; Protocols" unique_id="194" master_id="0" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="1" foreground="#f05517" ts_creation="1792540800" ts_lastsave="1792540800">
