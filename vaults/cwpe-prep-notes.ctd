<node name="WPS" unique_id="196" master_id="0" prog_lang="custom-colors" tags="cwpe protocol" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#f05517">At a glance
</rich_text>
<rich_text>What it is: </rich_text>
<rich_text style="italic">e.g. Push-button and PIN setup for home and small office routers</rich_text>
<rich_text>
</rich_text>
<rich_text>Learned in: </rich_text>
<rich_text link="node 31" foreground="#f05517">M02 - Attacking Wi-Fi Protected Setup (WPS)</rich_text>
<rich_text>
</rich_text>
<rich_text>Usual tools: </rich_text>
<rich_text style="italic">e.g. </rich_text>
<rich_text style="italic" link="node 195" foreground="#f05517">Aircrack-ng</rich_text>
<rich_text style="italic">, wash, reaver</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#f05517">First Look</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">the first commands you run against a new instance</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#f05517">Checklist</rich_text>
<rich_text>
</rich_text>
