<rich_text>Used in: </rich_text>
<rich_text style="italic" foreground="#8a8d96">link the methodology phase(s)</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Tools: </rich_text>
<rich_text style="italic">e.g. </rich_text>
<rich_text style="italic" link="node 283" foreground="#e647ba">BloodHound</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Index: </rich_text>
<rich_text link="node 13" foreground="#e647ba">Modules</rich_text>
<rich_text>
</rich_text>
<codebox char_offset="271" justification="left" frame_width="100" frame_height="74" width_in_pixels="0" syntax_highlighting="sh" highlight_brackets="1" show_line_numbers="0"># command            # what it does</codebox>
<table char_offset="519" justification="left" col_min="60" col_max="240" is_light="0" col_widths="240,240,240"><row><cell>e.g. A password in a user's description field</cell><cell>e.g. Admins leave temporary passwords there</cell><cell>e.g. Test it against that account</cell></row><row><cell>What you see</cell><cell>Why it matters</cell><cell>Next step</cell></row></table>
<codebox char_offset="625" justification="left" frame_width="100" frame_height="74" width_in_pixels="0" syntax_highlighting="sh" highlight_brackets="1" show_line_numbers="0"># command            # what it does</codebox>
</node>
