<node name="Targets" unique_id="294" master_id="0" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="1" foreground="#e647ba" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text>One node per item. Start with </rich_text>
<rich_text link="node 295" foreground="#e647ba">Target 1</rich_text>
<rich_text> and rename it. For each new one, duplicate </rich_text>
