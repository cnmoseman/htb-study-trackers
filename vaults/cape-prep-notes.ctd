<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text weight="heavy">Tools</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#e647ba">Module Tools</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. BloodHound: what you used it for in this module</rich_text>
<rich_text> </rich_text>
<rich_text style="italic" foreground="#8a8d96">link it to its node under Tools &amp; Services</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#e647ba">Gotchas / Lessons Learned</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text style="italic">e.g. A mistake you made in a lab and what fixed it</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#e647ba">Links</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Methodology: </rich_text>
<rich_text link="node 2" foreground="#e647ba">Methodology</rich_text>
<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Index: </rich_text>
<rich_text link="node 13" foreground="#e647ba">Modules</rich_text>
<rich_text>
</rich_text>
