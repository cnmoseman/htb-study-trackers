<node name="08 - Flags" unique_id="363" master_id="0" prog_lang="custom-colors" tags="cjca exam" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#1688ff">10 flags
</rich_text>
<rich_text>5 machines, each with a user and a root flag worth 10 points. Reviewers report a pass mark of 80 of 100, and the report has to pass too.</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">add rows as you find more</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text foreground="#8a8d96">────────────────────────────────────────
</rich_text>
