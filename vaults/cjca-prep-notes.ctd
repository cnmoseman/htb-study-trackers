<table char_offset="240" justification="left" col_min="60" col_max="240" is_light="0" col_widths="83,101,155,240"><row><cell>e.g. 80</cell><cell>e.g. HTTP</cell><cell>e.g. Apache 2.4</cell><cell>e.g. Login page and a file upload form</cell></row><row><cell>Port</cell><cell>Service</cell><cell>Version</cell><cell>Notes</cell></row></table>
