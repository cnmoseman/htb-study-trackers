<rich_text>
</rich_text>
<rich_text>• </rich_text>
<rich_text>Reporting: </rich_text>
<rich_text link="webs https://docs.sysreptor.com/assets/reports/HTB-COAE-Report.pdf" foreground="#867be5">SysReptor HTB-COAE template</rich_text>
<rich_text> + </rich_text>
<rich_text link="webs https://academy.hackthebox.com/course/preview/documentation--reporting" foreground="#867be5">Documentation &amp; Reporting module</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text foreground="#8a8d96">────────────────────────────────────────
</rich_text>
