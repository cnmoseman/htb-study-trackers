<rich_text style="italic" link="node 257" foreground="#867be5">PyTorch</rich_text>
<rich_text style="italic">, Burp Suite</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#867be5">First Look</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">the first commands you run against a new instance</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#867be5">Checklist</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Model or framework identified</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Behavior against its instructions tested</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Tools and plugins it can call listed</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>Data it reads (documents, search, memory) listed</rich_text>
<rich_text>
</rich_text>
<rich_text>☐ </rich_text>
<rich_text>How its output is used checked (shown, run or stored)</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#867be5">Red Flags</rich_text>
<rich_text>
</rich_text>
