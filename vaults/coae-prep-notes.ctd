<node name="Technology" unique_id="279" master_id="0" prog_lang="custom-colors" tags="coae technology" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
