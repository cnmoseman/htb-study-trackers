<node name="MCP Server" unique_id="258" master_id="0" prog_lang="custom-colors" tags="coae technology" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792540800" ts_lastsave="1792540800">
<rich_text weight="heavy" foreground="#867be5">At a glance
</rich_text>
<rich_text>What it is: </rich_text>
<rich_text style="italic">e.g. Gives a model tools it can call: files, APIs, databases</rich_text>
<rich_text>
</rich_text>
<rich_text>Where you see it: </rich_text>
<rich_text style="italic">e.g. Behind the chat app, listed in its tool settings</rich_text>
<rich_text>
</rich_text>
