<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
<rich_text scale="h2" weight="heavy" foreground="#867be5">Commands by Goal</rich_text>
<rich_text>
</rich_text>
<rich_text style="italic" foreground="#8a8d96">one heading per thing you want from it</rich_text>
<rich_text>
</rich_text>
<rich_text>
</rich_text>
